{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "effect-preset.json",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "effectId",
    "parameters"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "effectId": {
      "type": "string"
    },
    "parameters": {
      "type": "object"
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timeUs",
          "values"
        ],
        "properties": {
          "timeUs": {
            "type": "integer",
            "minimum": 0
          },
          "values": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://samvid.org/orchit/formats/effect-preset.json.schema.json"
}
