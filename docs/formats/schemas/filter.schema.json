{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filter.json",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "lut",
    "parameters"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "lut": {
      "type": "object",
      "required": [
        "path",
        "license"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://samvid.org/orchit/formats/filter.json.schema.json"
}
