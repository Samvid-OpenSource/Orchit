{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "text-animation.json",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "timing",
    "keyframes"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "timing": {
      "type": "object",
      "required": [
        "durationUs",
        "delayUs"
      ],
      "properties": {
        "durationUs": {
          "type": "integer",
          "minimum": 0
        },
        "delayUs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "property",
          "timeUs",
          "value",
          "easing"
        ],
        "properties": {
          "property": {
            "type": "string"
          },
          "timeUs": {
            "type": "integer",
            "minimum": 0
          },
          "value": {},
          "easing": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "const": "font"
          },
          "license": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://samvid.org/orchit/formats/text-animation.json.schema.json"
}
